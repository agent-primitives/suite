{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suite.agent-primitives.dev/schema/draft/build-profile.schema.json",
  "title": "Agent Sandbox Image build profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mediaType", "id", "runtimeBase", "harness", "sourceEpoch"],
  "properties": {
    "schemaVersion": {"const": "1.0.0-draft"},
    "mediaType": {"const": "application/vnd.agentsuite.build.profile.v1+json"},
    "id": {"$ref": "#/$defs/id"},
    "runtimeBase": {"$ref": "#/$defs/images"},
    "harness": {"$ref": "#/$defs/images"},
    "sourceEpoch": {"type": "integer", "minimum": 1},
    "execution": {"description": "Experimental image-serving contract, including its configuration mapping; does not select a member runtime. See spec sections 1.1.1 and 6.2.", "$ref": "execution.schema.json"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": {"const": "linux"},
        "architecture": {"enum": ["amd64", "arm64"]}
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "digest", "size"],
      "properties": {
        "mediaType": {"const": "application/vnd.oci.image.manifest.v1+json"},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "imageRef", "image"],
        "properties": {
          "platform": {"$ref": "#/$defs/platform"},
          "imageRef": {
            "type": "string",
            "description": "Bracketed authorities follow Go IPv6 syntax and port bounds; legacy DNS/path constraints are unchanged.",
            "pattern": "^(?:[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::[0-9]+)?|\\[(?:(?:[a-fA-F0-9]{1,4}:){7}[a-fA-F0-9]{1,4}|(?:[a-fA-F0-9]{1,4}:){1,7}:|(?:[a-fA-F0-9]{1,4}:){1,6}:[a-fA-F0-9]{1,4}|(?:[a-fA-F0-9]{1,4}:){1,5}(?::[a-fA-F0-9]{1,4}){1,2}|(?:[a-fA-F0-9]{1,4}:){1,4}(?::[a-fA-F0-9]{1,4}){1,3}|(?:[a-fA-F0-9]{1,4}:){1,3}(?::[a-fA-F0-9]{1,4}){1,4}|(?:[a-fA-F0-9]{1,4}:){1,2}(?::[a-fA-F0-9]{1,4}){1,5}|[a-fA-F0-9]{1,4}:(?::[a-fA-F0-9]{1,4}){1,6}|:(?::[a-fA-F0-9]{1,4}){1,7}|::)\\](?::0*(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?)(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+@sha256:[a-f0-9]{64}$",
            "not": {"pattern":"^\\[[a-fA-F0-9:]+\\](?::[0-9]+)?/[^@]{256}|^\\[[^\\n]*\\n$"}
          },
          "image": {"$ref": "#/$defs/descriptor"}
        }
      }
    }
  }
}
