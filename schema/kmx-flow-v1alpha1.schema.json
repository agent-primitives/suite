{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suite.agent-primitives.dev/schema/draft/kmx-flow-v1alpha1.schema.json",
  "title": "Experimental kmx serial flow v1alpha1",
  "description": "Explicit critical-extension payload, not a core manifest or runtime-support claim. Graph references, ordering, aggregate bounds and RE2 syntax require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "mode", "entry", "edgeRequirements", "steps", "cases"],
  "properties": {
    "schemaVersion": {"const": "kmx.flow/v1alpha1"},
    "id": {"$ref": "#/$defs/memberID"},
    "mode": {"const": "pipeline"},
    "entry": {"$ref": "#/$defs/memberID"},
    "edgeRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "approval"],
        "properties": {
          "from": {"$ref": "#/$defs/memberID"},
          "to": {"$ref": "#/$defs/memberID"},
          "approval": {"$ref": "#/$defs/approval"}
        }
      }
    },
    "steps": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "member", "input"],
        "properties": {
          "id": {"$ref": "eval-case.schema.json#/$defs/id"},
          "member": {"$ref": "#/$defs/memberID"},
          "approval": {"$ref": "#/$defs/approval"},
          "input": {
            "type": "object", "additionalProperties": false,
            "required": ["source"],
            "properties": {
              "source": {"type": "string", "pattern": "^(run\\.input|[A-Za-z0-9][A-Za-z0-9._-]{0,62}\\.output)$"},
              "context": {"const": "run.input"}
            }
          }
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "input", "assertions"],
        "dependentRequired": {"minPasses": ["runs"]},
        "properties": {
          "id": {"$ref": "eval-case.schema.json#/$defs/id"},
          "input": {"type": "string", "pattern": "\\S"},
          "runs": {"type": "integer", "minimum": 1, "maximum": 1000},
          "minPasses": {"type": "integer", "minimum": 1, "maximum": 1000},
          "assertions": {
            "type": "array", "minItems": 1, "maxItems": 1000,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["step", "check"],
              "properties": {
                "step": {"$ref": "eval-case.schema.json#/$defs/id"},
                "check": {
                  "$ref": "eval-case.schema.json#/$defs/assertion",
                  "properties": {"type": {"enum": ["contains", "notContains", "regex"]}}
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "memberID": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "approval": {"enum": ["required", "policy-controlled"]}
  }
}
